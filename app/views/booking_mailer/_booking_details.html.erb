<table
  width="100%"
  cellpadding="0"
  cellspacing="0"
  border="0"
  style="
    border: 1px solid #dfe3e8;
    border-radius: 8px;
    overflow: hidden;
  "
>
  <tr>
    <td style="
      padding: 14px 16px;
      background-color: #f7f9fb;
      font-weight: bold;
      color: #334e68;
    ">
      Booking Details
    </td>
  </tr>

  <tr>
    <td style="padding: 16px;">

      <table
        width="100%"
        cellpadding="0"
        cellspacing="0"
        border="0"
      >

        <tr>
          <td style="
            padding: 6px 0;
            color: #637381;
          ">
            Booking ID
          </td>

          <td style="
            padding: 6px 0;
            text-align: right;
            font-weight: bold;
          ">
            #<%= @booking.id %>
          </td>
        </tr>

        <tr>
          <td style="
            padding: 6px 0;
            color: #637381;
          ">
            Route
          </td>

          <td style="
            padding: 6px 0;
            text-align: right;
            font-weight: bold;
          ">
            <%= @booking.trip.from_city %>
            →
            <%= @booking.trip.to_city %>
          </td>
        </tr>

        <tr>
          <td style="
            padding: 6px 0;
            color: #637381;
          ">
            Operator
          </td>

          <td style="
            padding: 6px 0;
            text-align: right;
          ">
            <%= @booking.trip.operator.name %>
          </td>
        </tr>

        <tr>
          <td style="
            padding: 6px 0;
            color: #637381;
          ">
            Bus
          </td>

          <td style="
            padding: 6px 0;
            text-align: right;
          ">
            <%= @booking.trip.bus.name %>
          </td>
        </tr>

        <tr>
          <td style="
            padding: 6px 0;
            color: #637381;
          ">
            Departure
          </td>

          <td style="
            padding: 6px 0;
            text-align: right;
          ">
            <%= @booking.trip.departure_at.strftime("%d %b %Y, %I:%M %p") %>
          </td>
        </tr>

        <tr>
          <td style="
            padding: 6px 0;
            color: #637381;
          ">
            Seats
          </td>

          <td style="
            padding: 6px 0;
            text-align: right;
            font-weight: bold;
          ">
            <%= @booking.booking_seats.map { |booking_seat|
              booking_seat.trip_seat.seat.seat_number
            }.join(", ") %>
          </td>
        </tr>

      </table>

    </td>
  </tr>
</table>
