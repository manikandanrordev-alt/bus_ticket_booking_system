<h1 style="
  margin: 0 0 8px;
  color: #b42318;
  font-size: 26px;
">
  Booking Cancelled
</h1>

<p style="
  margin: 0 0 24px;
  color: #52606d;
  font-size: 15px;
  line-height: 24px;
">
  Hello <strong><%= @booking.user.email %></strong>,
</p>

<p style="
  margin: 0 0 24px;
  color: #52606d;
  font-size: 15px;
  line-height: 24px;
">
  Your booking has been cancelled successfully.
</p>

<%= render "booking_details" %>

<table
  width="100%"
  cellpadding="0"
  cellspacing="0"
  border="0"
  style="margin-top: 20px;"
>
  <tr>
    <td style="
      padding: 10px 0;
      color: #637381;
    ">
      Ticket Amount
    </td>

    <td style="
      padding: 10px 0;
      text-align: right;
    ">
      ₹<%= @ticket_amount %>
    </td>
  </tr>

  <tr>
    <td style="
      padding: 10px 0;
      color: #637381;
    ">
      Cancellation Fee
    </td>

    <td style="
      padding: 10px 0;
      text-align: right;
    ">
      ₹<%= @cancellation_fee %>
    </td>
  </tr>

  <tr>
    <td style="
      border-top: 1px solid #dfe3e8;
      padding: 14px 0;
      font-weight: bold;
    ">
      Refund Amount
    </td>

    <td style="
      border-top: 1px solid #dfe3e8;
      padding: 14px 0;
      text-align: right;
      font-weight: bold;
      color: #1b5e20;
    ">
      ₹<%= @refund_amount %>
    </td>
  </tr>
</table>
