<div class="auth-page">
  <div class="auth-card">

    <div class="auth-brand">
      <div class="brand-icon">🎟️</div>
      <h1>Ticket<span>Book</span></h1>
      <p>Book your journey. Simply.</p>
    </div>

    <div class="auth-content">
      <h2>Welcome back</h2>
      <p class="auth-description">
        Enter your email to continue booking your next journey.
      </p>

      <% if flash[:alert] %>
        <div class="alert alert-error">
          <span>⚠</span>
          <%= flash[:alert] %>
        </div>
      <% end %>

      <% if flash[:notice] %>
        <div class="alert alert-success">
          <span>✓</span>
          <%= flash[:notice] %>
        </div>
      <% end %>

      <%= form_with url: login_path, method: :post, class: "auth-form" do |form| %>

        <div class="form-group">
          <%= form.label :email, "Email address" %>

          <div class="input-wrapper">
            <span class="input-icon">✉</span>

            <%= form.email_field :email, placeholder: "you@example.com", autocomplete: "email", required: true, autofocus: true %> </div>
        </div>

        <%= form.submit "Continue", class: "auth-button" %>

      <% end %>

      <div class="auth-divider">
        <span>New to TicketBook?</span>
      </div>

      <%= link_to "Create an account", signup_path, class: "secondary-button" %>
    </div>

    <div class="auth-footer">
      <span>🔒</span>
      Secure & simple authentication
    </div>

  </div>
</div>